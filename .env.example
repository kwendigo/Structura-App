# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ONESIGNAL_APP_ID: Public OneSignal App ID used by the browser Web SDK.
VITE_ONESIGNAL_APP_ID="MY_ONESIGNAL_APP_ID"

# OneSignal server credentials. Configure these in Vercel project environment
# variables; never expose the REST API key through a VITE_ variable.
ONESIGNAL_APP_ID="MY_ONESIGNAL_APP_ID"
ONESIGNAL_REST_API_KEY="MY_ONESIGNAL_REST_API_KEY"
ONESIGNAL_SCHEDULER_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
